[local]
core_number=2
checkpoint_interval=10
node_memory_limit_mb=4000
enable_data_store=true
enable_wal=true
# Relative to the directory eloqdoc is started from.
eloq_data_path=data
event_dispatcher_num=1
#auto_redirect=true
enable_mvcc=true
logserver_snapshot_interval=60

[cluster]
tx_ip_port_list=127.0.0.1:16379
#txlog_service_list=127.0.0.1:9000
#txlog_group_replica_num=1

[store]
# Local EloqStore, reached through dss_server.
eloq_store_buffer_pool_size=500MB
eloq_store_pages_per_file_shift=11
